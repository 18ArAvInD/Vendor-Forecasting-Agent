# Example environment configuration for the Vendor Forecasting Agent.
#
# Copy this file to ".env" (or export these variables in your shell) and fill in
# your own values. Do NOT commit a real API key. The deterministic engine works
# fully without any of these; they only enable the optional AI explanation layer.
#
# --- Official Mistral API (default AI provider) ------------------------------
# Set MISTRAL_API_KEY to enable the Mistral API provider. When it is empty/unset
# the app runs offline (deterministic analysis only) and never crashes.
MISTRAL_API_KEY=
# Model id used for chat/completions. Defaults to mistral-medium-latest.
MISTRAL_MODEL_ID=mistral-medium-latest

# --- Shared LLM inference settings -------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# --- AWS Bedrock (legacy/alternative provider, optional) ---------------------
# Used only when MISTRAL_API_KEY is not set but BEDROCK_MODEL_ID is.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
